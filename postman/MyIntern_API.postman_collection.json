              "mode": "raw",
              "raw": "{\"first_name\":\"Postman\",\"last_name\":\"Student\",\"username\":\"{{username}}\",\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
